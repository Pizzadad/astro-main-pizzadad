---
import { actions } from "astro:actions";

import { InfoStats, InfoImage } from "@/components/ParfamInfo/";

import InfoType from "@/components/ParfamInfo/InfoType";

import MainLayout from "@/layouts/MainLayout.astro";

import { HeartIcon } from "@/components/ParfamInfo/icons";
import { Whatsapp } from "@/components/Shared";

import type { ParfamWithImages } from "@/interfaces/parfam-with-images.interface";

import InfoSlider from "@/components/ParfamInfo/InfoSlider.astro";

// export const prerender = true;

// export const getStaticPaths = (async () => {
//   const data = await getParfamJson();

//   return data.map((parfam) => ({
//     params: {
//       slug: parfam.slug,
//     },
//     props: {
//       parfam,
//     },
//   }));
// }) satisfies GetStaticPaths;

// const {data, error} = await actions.getParfamsBySlug(slug ?? '');

const { slug } = Astro.params;

const { data, error } = await Astro.callAction(
  actions.getParfamsBySlug,
  slug ?? ""
);

if (error) {
  return Astro.redirect("/");
}

const { parfam } = data;

const phoneNumber = import.meta.env.PHONE_NUMBER;
const message = import.meta.env.MESSAGE_DEFAULT;

const joinNotes = (items: string[]) => {
  if (items.length === 0) return "";
  if (items.length === 1) return items[0];
  const allButLast = items.slice(0, -1).join(", ");
  const last = items[items.length - 1];
  return `${allButLast} y ${last}`;
};

const getNotesText = (parfam: ParfamWithImages) => {
  const sections = [];

  if (parfam.topNotes.length > 0) {
    const topNotes = joinNotes(parfam.topNotes);
    sections.push(`Las Notas de Salida son ${topNotes}`);
  }

  if (parfam.midNotes.length > 0) {
    const midNotes = joinNotes(parfam.midNotes);
    sections.push(`las Notas de Corazón son ${midNotes}`);
  }

  if (parfam.baseNotes.length > 0) {
    const baseNotes = joinNotes(parfam.baseNotes);
    sections.push(`las Notas de Fondo son ${baseNotes}`);
  }

  return sections.join("; ") + ".";
};

const textNotes = getNotesText(parfam);

---

<MainLayout>
  <!-- component -->

  <section class="overflow-hidden">
    <div class="flex lg:flex-row flex-col w-full mx-auto">
      <div
        class="flex-col flex w-1/3 max-w-[26rem]
          relative self-center"
      >
        <InfoSlider parfam={parfam} />
        <!-- <InfoImage parfam={parfam} /> -->
      </div>

      <div
        class="flex flex-col gap-4 lg:w-2/3 w-full lg:pl-10 lg:py-6 mt-6 lg:mt-0"
      >

      

        <div class="flex justify-between">
          <h1 class="font-extrabold text-title lg:text-3xl text-xl mb-1">
            {parfam.name}
          </h1>

          <button
            class="lg:top-4 top-0 lg:right-4 right-0 max-h-[48px] max-w-[48px] select-none rounded-full text-center align-middle
              font-sans text-xs font-medium uppercase text-principal transition-all hover:bg-red-500/10 active:bg-principalHover/30
              disabled:pointer-events-none disabled:opacity-50 disabled:shadow-none"
            type="button"
            data-ripple-dark="true"
          >
            <!-- <HeartIcon isFilled={false} /> -->
          </button>
        </div>

        <h2
          class="text-base font-bold text-gray-500 tracking-widest lg:mb-0 mb-4"
        >
          {parfam.desiger}
        </h2>

        <div class="flex lg:flex-row flex-col gap-4 mb-2">
          <div class="flex flex-col lg:w-2/3 w-full">
            <InfoStats text="Temporada" season={parfam.season} />
          </div>
          <div class="flex flex-col lg:w-1/3 w-full">
            <InfoStats text="Tiempo" hour={parfam.hour} />
          </div>
        </div>

        <!-- <div class="flex flex-col gap-2">
            <p class="leading-relaxed">Descripción</p>
            <p class="text-justify leading-relaxed">
              {parfam.description}
            </p>
          </div> -->

        <div class="flex flex-row items-center w-full mx-auto px-2">
          <div class="text-4xl text-principal rotate-12">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="100%"
              height="100%"
              viewBox="0 0 24 24"
              ><path
                fill="currentColor"
                d="M9.583 17.321C8.553 16.227 8 15 8 13.011c0-3.5 2.457-6.637 6.03-8.188l.893 1.378c-3.335 1.804-3.987 4.145-4.247 5.621c.537-.278 1.24-.375 1.929-.311c1.804.167 3.226 1.648 3.226 3.489a3.5 3.5 0 0 1-3.5 3.5a3.87 3.87 0 0 1-2.748-1.179"
              ></path></svg
            >
          </div>
          <p
            class="md:text-sm text-base text-gray-600 md:text-justify text-center italic"
          >
            {textNotes}
          </p>
          <div class="text-4xl text-principal rotate-12">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="100%"
              height="100%"
              viewBox="0 0 24 24"
              ><path
                fill="currentColor"
                d="M14.417 6.679C15.447 7.773 16 9 16 10.989c0 3.5-2.456 6.637-6.03 8.188l-.893-1.378c3.335-1.804 3.987-4.145 4.248-5.621c-.537.278-1.24.375-1.93.311C9.591 12.323 8.17 10.842 8.17 9a3.5 3.5 0 0 1 3.5-3.5c1.073 0 2.1.49 2.748 1.179"
              ></path></svg
            >
          </div>
        </div>

        <p
          class="text-sm title-font text-gray-500 tracking-widest lg:mb-0 mb-4"
        >
          Seleccione una presentación y de click al icono de Whatsapp para
          continuar la compra
        </p>

        <InfoType 
          types={parfam.types} 
          client:load  />
      </div>
    </div>
  </section>
  <!-- message=`${message} ${parfam.name}`  -->
  <Whatsapp
    phoneNumber={phoneNumber}
    message={message.replace("parfam", `${parfam.name}`)}
  />
</MainLayout>


<script>
  import { selectedSize } from "@/store";

  selectedSize.subscribe((value) => {
    const sizeElement = document.getElementById('selected-size');
    if (sizeElement) {
      sizeElement.textContent = `Tamaño seleccionado: ${value || 'Ninguno'}`;
    }
  });
</script>