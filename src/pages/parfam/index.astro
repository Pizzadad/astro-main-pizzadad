---
import { actions } from 'astro:actions';



import { Pagination } from '@/components/Shared';
import MainLayout from '@/layouts/MainLayout.astro';
import ParfamCard from '@/components/Parfam/ParfamCard.astro';


const searchParams = Astro.url.searchParams;
const pageParam = Number(searchParams.get('page') ?? 1);

// const {data, error}  = await actions.getParfamsByPage({
//   page: pageParam,
// });

const { data, error } = await Astro.callAction(actions.getParfamsByPage, { page: pageParam });

if (error) {
  return Astro.redirect('/parfam');
}

const {parfams, totalPages} = data;

---
<MainLayout>
  <div class="container mx-auto flex flex-wrap justify-center  w-full h-full gap-4">
    <h1 class="text-3xl">Lista de perfumes</h1>

    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 md:grid-cols-3 place-items-center">
      {parfams.map((parfam) => (
        <div class="w-full h-90 shadow-xl shadow-red-700/40 text-center">
          <ParfamCard parfam={parfam} />      
        </div>
      ))}
    </div>

    <Pagination totalPages={totalPages} />

  </div>
</MainLayout>