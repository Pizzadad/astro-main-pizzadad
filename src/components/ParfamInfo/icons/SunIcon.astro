---
interface Props {
  fillColor?: string;
  fillPercentage?: number;
}

const { fillColor = "#b51818", fillPercentage = 100 } = Astro.props;
const gradientId = Math.random().toString(36).substring(2, 15);

const maxSexteen = fillPercentage > 60 ? true : false;

const realColor = maxSexteen ? fillColor : "#999999";
