---
export interface Props {
  size: string;
  price: number;
}

const { price, size } = Astro.props;
---

<>
  <div class="lg:w-1/4 md:w-1/3 xs:w-1/2 w-full">
    <div
      class="h-full p-6 rounded-lg border-2 flex flex-col relative overflow-hidden borderUnSelected"      
    >
      <h2 class="text-sm tracking-widest title-font mb-1 font-medium">
        PRESENTACIÓN
      </h2>
      <h1
        class="text-5xl text-gray-900 leading-none flex items-center pb-4 mb-4 border-b border-gray-200"
      >
        <span data-size={size}>{size}</span>
        <span class="text-lg ml-1 font-normal text-gray-500">/ML</span>
      </h1>

      <p class="flex items-center text-gray-600">S/ {price}</p>
    </div>
  </div>
</>

<script>
    const elements = document.querySelectorAll(".borderUnSelected"); // Selecciona todos los elementos relevantes
  
    elements.forEach((liElement) => {
    liElement.addEventListener('click', () => {
        elements.forEach((s) => s.classList.remove('borderSelected'));
      liElement.classList.add('borderSelected');
    
      const selectedDiv = document.querySelector('.borderSelected')

      if(selectedDiv){
        const dataSize = selectedDiv.querySelector('span[data-size]')?.getAttribute('data-size') as string;
        
        const whatsappLink = document.querySelector('#whatsappLink') as HTMLAnchorElement;

        const updatedHref = whatsappLink.href.replace('size', dataSize);
        
        whatsappLink.href = updatedHref;
        
      }

    });
  });

</script>

<style>
  .borderSelected {
    @apply border-principal;
  }
  ,
  .borderUnSelected {
    @apply border-gray-400;
  }
</style>
