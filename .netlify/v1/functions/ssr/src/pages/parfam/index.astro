---
import { actions } from 'astro:actions';



import { Pagination } from '@/components/Shared';
import MainLayout from '@/layouts/MainLayout.astro';
import ParfamList from '@/components/Parfam/ParfamList.astro';

const searchParams = Astro.url.searchParams;
const pageParam = Number(searchParams.get('page') ?? 1);

// const {data, error}  = await actions.getParfamsByPage({
//   page: pageParam,
// });

const { data, error } = await Astro.callAction(actions.getParfamsByPage, { page: pageParam });
console.log(error)
if (error) {
  return Astro.redirect('/parfam');
}

const {parfams, totalPages} = data;

---
<MainLayout>
  <div class="container mx-auto flex flex-wrap w-full h-full gap-4">
    <h1 class="text-3xl">Listado de productos</h1>
    <ParfamList parfams={parfams}/>
  
    <Pagination totalPages={totalPages} />

  </div>
</MainLayout>